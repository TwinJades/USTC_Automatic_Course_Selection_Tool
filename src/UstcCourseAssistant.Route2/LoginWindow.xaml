<Window x:Class="UstcCourseAssistant.Route2.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="教务系统 - 选课助手"
        Icon="Assets/CourseAssistant.ico"
        Height="780" Width="1180" MinHeight="600" MinWidth="820"
        Background="{StaticResource WindowBackgroundBrush}">

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1" Padding="16,11" Effect="{StaticResource CardShadow}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" Padding="4" Margin="0,0,11,0">
          <Image x:Name="BrowserWindowIcon" Source="Assets/CourseAssistant.png" Stretch="Uniform" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBox Style="{StaticResource CopyableText}" Text="教务系统"
                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" />
          <TextBox Style="{StaticResource CopyableText}" Text="自动登录仅处理正常账号密码表单；短信与验证码请由本人完成"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="12" Padding="10,5" HorizontalAlignment="Right">
            <TextBox Style="{StaticResource CopyableText}" Text="学生制作 · 非官方"
                     Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
          </Border>
          <TextBox Style="{StaticResource CopyableText}" Text="密码仅按你的选择保存到 Windows 凭据管理器；不会读取验证码"
                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Background="{StaticResource AccentSoftBrush}"
            BorderBrush="#D3DFEF" BorderThickness="0,0,0,1" Padding="16,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Style="{StaticResource CopyableText}"
                 Text="下方内容由中国科学技术大学教务系统提供；本工具不修改校方网页。"
                 Foreground="{StaticResource TextSecondaryBrush}" />
        <TextBox Grid.Column="1" x:Name="BrowserStatusText" Style="{StaticResource CopyableText}"
                 Text="正在初始化安全浏览器环境…" Foreground="{StaticResource AccentBrush}"
                 FontWeight="SemiBold" Margin="16,0,0,0" />
      </Grid>
    </Border>
    <wv2:WebView2 x:Name="Browser" />
  </DockPanel>
</Window>
