<Window x:Class="UstcCourseAssistant.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="USTC 选课助手" Height="650" Width="980" MinHeight="540" MinWidth="800">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="USTC 选课助手" FontSize="24" FontWeight="SemiBold" />
      <StackPanel Orientation="Horizontal" Margin="0,4,0,12"><TextBlock Text="本机运行 · 认证由用户完成 · 不保存短信验证码" Foreground="Gray"/><TextBlock Text="  ·  版本 1.0.0" Foreground="Gray"/></StackPanel>
      <WrapPanel>
        <Button Content="开始监测" Click="Start_Click"/><Button Content="暂停" Click="Stop_Click"/><Button Content="立即检查（不选课）" Click="CheckNow_Click"/>
        <Button Content="打开教务登录" Click="OpenLogin_Click"/><TextBlock x:Name="StateText" VerticalAlignment="Center" Margin="12,0" Text="未运行" />
      </WrapPanel>
      <Grid Margin="0,12,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="检查间隔"/><ComboBox x:Name="IntervalBox" SelectionChanged="SettingsChanged"><ComboBoxItem Content="5 秒"/><ComboBoxItem Content="15 秒"/><ComboBoxItem Content="60 秒"/><ComboBoxItem Content="自定义"/></ComboBox></StackPanel>
        <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="自定义秒数"/><TextBox x:Name="CustomIntervalBox" TextChanged="SettingsChanged"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="运行时段"/><CheckBox x:Name="ScheduleBox" Content="启用" Checked="SettingsChanged" Unchecked="SettingsChanged"/></StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal"><StackPanel><TextBlock Text="开始"/><TextBox x:Name="StartTimeBox" Width="90" TextChanged="SettingsChanged"/></StackPanel><StackPanel Margin="12,0"><TextBlock Text="结束"/><TextBox x:Name="EndTimeBox" Width="90" TextChanged="SettingsChanged"/></StackPanel><CheckBox x:Name="WeekdaysBox" Content="仅工作日" VerticalAlignment="Bottom" Margin="12,0" Checked="SettingsChanged" Unchecked="SettingsChanged"/></StackPanel>
      </Grid>
    </StackPanel>
    <TabControl>
      <TabItem Header="待选课程"><DockPanel Margin="8"><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0"><Button Content="添加课程" Click="Add_Click"/><Button Content="删除选中项" Click="Delete_Click"/><Button Content="优先级上移" Click="Up_Click"/><Button Content="优先级下移" Click="Down_Click"/></StackPanel><DataGrid x:Name="TasksGrid" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}"/><DataGridTextColumn Header="课程代码" Binding="{Binding CourseCode}" Width="*"/><DataGridTextColumn Header="课程名称" Binding="{Binding CourseName}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="优先级" Binding="{Binding Priority}" IsReadOnly="True"/><DataGridTextColumn Header="冲突旧课（逗号分隔）" Binding="{Binding ConflictsText}" Width="2*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="2*" IsReadOnly="True"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
      <TabItem Header="本地日志"><ListBox x:Name="LogBox" Margin="8"/></TabItem>
      <TabItem Header="账户与安全"><StackPanel Margin="18"><TextBlock Text="账号（可保存）"/><TextBox x:Name="StudentIdBox" Width="240" HorizontalAlignment="Left" TextChanged="SettingsChanged"/><TextBlock Margin="0,16,0,4" Text="密码不会写进配置文件。登录窗口完成统一身份认证与短信验证后，软件只复用当前正常会话。" TextWrapping="Wrap"/><CheckBox x:Name="StartupBox" Content="开机自动启动（默认关闭）" Checked="SettingsChanged" Unchecked="SettingsChanged"/></StackPanel></TabItem>
    </TabControl>
  </DockPanel>
</Window>
