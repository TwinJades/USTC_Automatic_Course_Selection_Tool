@echo off
setlocal
set "USTC_PACKAGE_ROOT=%~dp0"
powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $root=[IO.Path]::GetFullPath([Environment]::GetEnvironmentVariable('USTC_PACKAGE_ROOT')).TrimEnd([IO.Path]::DirectorySeparatorChar); $a=Join-Path $root 'data\updates\active'; $j=Join-Path $a 'journal.json'; if(Test-Path -LiteralPath $a){ $stage=if(Test-Path -LiteralPath $j){(Get-Content -Raw -LiteralPath $j -Encoding UTF8 | ConvertFrom-Json).Stage}else{''}; if($stage -eq '' -or $stage -eq 'Downloading'){ $p=Start-Process -FilePath (Join-Path $root 'app\UstcCourseAssistant.Route2.exe') -ArgumentList @('--update-helper', 'recover', ('\"'+$root+'\"')) -PassThru; $null=$p.Handle; $p.WaitForExit(); $p.Refresh(); if($null -eq $p.ExitCode -or $p.ExitCode -ne 0){throw ('Recovery failed: '+$p.ExitCode)}; if(Test-Path -LiteralPath $a){throw 'Early recovery left active transaction'} } }"
if errorlevel 1 exit /b %errorlevel%
powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $root=[IO.Path]::GetFullPath([Environment]::GetEnvironmentVariable('USTC_PACKAGE_ROOT')).TrimEnd([IO.Path]::DirectorySeparatorChar); $a=Join-Path $root 'data\updates\active'; if(Test-Path -LiteralPath $a){ $j=Get-Content -LiteralPath (Join-Path $a 'journal.json') -Raw -Encoding UTF8 | ConvertFrom-Json; $l=Join-Path $a 'helper.sha256'; if((Get-FileHash -Algorithm SHA256 -LiteralPath $l).Hash -ne $j.HelperManifestSha256){throw 'Helper manifest digest mismatch'}; $base=Join-Path $a 'helper'; $rows=@(Get-Content -LiteralPath $l -Encoding UTF8); $seen=@{}; foreach($line in $rows){if($line -notmatch '^([0-9a-f]{64})  ([^\\:]+)$'){throw 'Invalid helper manifest'}; $h=$Matches[1]; $p=$Matches[2]; if($p -match '(^/|(^|/)\.\.?(/|$))' -or $seen.ContainsKey($p)){throw 'Invalid helper path'}; $seen[$p]=$true; $f=Join-Path $base ($p.Replace('/','\')); $item=Get-Item -LiteralPath $f; if(($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -or (Get-FileHash -Algorithm SHA256 -LiteralPath $f).Hash -ne $h){throw 'Invalid helper file'}}; $actual=@(Get-ChildItem -LiteralPath $base -Recurse -Force); if(@($actual | Where-Object { $_.Attributes -band [IO.FileAttributes]::ReparsePoint }).Count -ne 0 -or @($actual | Where-Object { -not $_.PSIsContainer }).Count -ne $rows.Count){throw 'Unexpected helper files'}; $p=Start-Process -FilePath (Join-Path $base 'UstcCourseAssistant.Route2.exe') -ArgumentList @('--update-helper', 'recover', ('\"'+$root+'\"')) -PassThru; $null=$p.Handle; $p.WaitForExit(); $p.Refresh(); if($null -eq $p.ExitCode -or $p.ExitCode -ne 0){throw ('Recovery failed: '+$p.ExitCode)} }; if(-not (Test-Path -LiteralPath (Join-Path $root 'app\UstcCourseAssistant.Route2.exe'))){throw 'Recovered application missing'}; Start-Process -FilePath (Join-Path $root 'app\UstcCourseAssistant.Route2.exe') -ArgumentList @('--package-root', ('\"'+$root.TrimEnd('\')+'\"'))" 
exit /b %errorlevel%
